# LINE Webhook 簽章驗證用的 Channel Secret。本地開發可填任意假字串——
# scripts/test_webhook.py 會用同一個值計算簽章，不需要真的 LINE 憑證；
# 只有接真的 LINE 驗收（見 README「接真的 LINE」）才需要換成 LINE Developers
# Console 給的真值。
LINE_CHANNEL_SECRET=change-me

# Router 呼叫 LINE Reply/Push Message API 用的 Channel Access Token。
# 同上，本地測試（假 user id）填任意假字串即可；只有要把回覆推播給
# 真實 LINE 使用者時才需要真值。
LINE_CHANNEL_ACCESS_TOKEN=change-me

# 宿主機上 data/ 的絕對路徑，Docker 掛載 volume 時需要用到。填你 clone
# 這個 repo 的實際絕對路徑，例如 /Users/xxx/alice-office-router/data。
HOST_DATA_DIR=change-me

# Set to false when running router on localhost (not inside Docker);
# true (容器化部署) is the default here since docker-compose mounts
# ./src/hermes automatically — host-mode dev must override to false.
ROUTER_IN_DOCKER=true

# ── ⚠️ Host 模式必填（ROUTER_IN_DOCKER=false 時才需要反注解下面兩行）──────
# 這兩個是 router 進程自己的檔案系統路徑（不是給 Docker volume 用的）。容器化
# 部署（ROUTER_IN_DOCKER=true，預設）保持註解、吃 /app/... 預設值即可，不要動。
#
# Host 模式忘了反注解會怎樣：app 啟動時直接 fail-fast 報錯（見 config.py
# Settings._validate_host_mode_paths），不會再像過去那樣無聲無息地跑起來、
# 卻在每個房間第一次建立時才各自默默失敗（config.yaml 寫不出來、MCP/plugin
# 沒 seed，錯誤只出現在 router 自己的 terminal）。
#
# DATA_DIR：router 自己讀寫房間資料（mkdir、寫 config.yaml）用的路徑，跟
# HOST_DATA_DIR 填同一個絕對路徑。
# DATA_DIR=/absolute/path/to/alice-office-router/data
# HERMES_TEMPLATES_DIR：這個 repo 的 src/hermes/ 絕對路徑（mcp/<name>/、
# plugin/<name>/ 樣板來源，見 container_manager.py 的 _ensure_mcp_seed /
# _ensure_plugin_seed）。
# HERMES_TEMPLATES_DIR=/absolute/path/to/alice-office-router/src/hermes
# ─────────────────────────────────────────────────────────────────────────

# Real Hermes Agent image (its api_server platform answers requests; the
# router owns all LINE communication, not Hermes's own LINE plugin)
HERMES_IMAGE=nousresearch/hermes-agent

# Shared bearer secret between the router and every Hermes container's
# api_server platform. Generate with: openssl rand -hex 32
HERMES_API_SERVER_KEY=change-me

# Router 判定 agent「已經死掉」的靜默上限（秒）。預設 120。Router 用 streaming 呼叫
# agent，Hermes 每靜默 30 秒就會送一次 keepalive（連工具執行中也會），所以「還活著」
# 等於「還有 bytes 進來」——一輪想再久都不會逾時，只有容器卡死才會踩到這條。
HERMES_IDLE_TIMEOUT_SECONDS=120

# 單一輪的絕對上限（秒）。預設 3600，是 keepalive 一直來但永遠不結束時的保險絲，
# 正常情況不會踩到（活著與否是看上面的 idle 逾時）。webhook 本身是非同步處理
# （已先回 200 給 LINE），所以調大不影響 LINE。任一條逾時後使用者會收到固定提示，
# agent 本身不會被中斷，那一輪的答案仍寫進 session，只是這次送不回來。
HERMES_REQUEST_TIMEOUT_SECONDS=3600

# LLM endpoint — templated into each room's config.yaml (providers.custom)
LLM_BASE_URL=change-me
LLM_API_KEY=change-me
LLM_MODEL=change-me

# ── Default plugins ──────────────────────────────────────────────────────
# Templates in src/hermes/plugin/ are seeded (once, per room — see
# HERMES_TEMPLATES_DIR above) into each room's own data/<room_id>/plugins/.
# The names below are written into each new room's config.yaml under
# plugins.enabled; they must match a seeded plugin directory name.
# DEFAULT_PLUGINS=local-tools

# For production, build the derivative image with plugin/MCP dependencies:
#   docker build -f Dockerfile.hermes -t alice-hermes-agent:v1 .
# Then set HERMES_IMAGE=alice-hermes-agent:v1 instead of the upstream image.

# ── Google Workspace 整合（Calendar / Gmail / Drive）───────────────────────
# 公開 HTTPS base URL（不含結尾斜線），例如 https://your-domain。LINE
# 使用者的瀏覽器要能連到 {url}/oauth/callback 完成 Google 授權；這個 URL
# 也要加進 GCP Console → 憑證 → Web application client 的
# Authorized redirect URIs，否則會出現 redirect_uri_mismatch 錯誤。
# 留空（預設）等於停用整個 Google 整合：oauth 路由回 400、新房間不會 seed
# gmail/drive/google-calendar 這三個 MCP、既有訊息也不會被擋。
GOOGLE_OAUTH_PUBLIC_URL=change-me

# 是否攔截尚未完成 Google 授權的房間訊息（見 README「Google Workspace 整合」）。
# 設 false 時 /oauth/start、/oauth/callback 仍正常運作，只是不擋訊息。
GOOGLE_OAUTH_GATE=true

# 除了上面兩個環境變數，Google 整合還需要把兩份 GCP OAuth credentials 放到
# 檔案系統（不進版控、不透過 .env），但只需放一次：
#   data/_google/gcp-oauth.keys.json            ← Web application client
#   data/_google/gcp-oauth.keys.installed.json  ← Desktop (Installed) client
# 兩者都在 GCP Console →「憑證」建立、下載 JSON 後放到上述路徑；detail 見
# README「Google Workspace 整合」一節。這裡只是「種子來源」——每個房間第一次
# 接觸 Google OAuth 時，會自動複製一份到自己的 data/<room_id>/google/，逐房
# 隔離（跟 data/<room_id>/mcp、plugins 同一個模式），不是共用掛載：不同房間的
# container 讀不到彼此的 tokens.json，砍掉一個房間的資料夾也只會清空那個房間
# 的 Google 授權。MCP process 以 uid 10000 的 hermes 使用者執行，Linux host 上
# 要確保每個房間的 data/<room_id>/google/ 對 uid 10000 可讀寫，因為 token
# refresh 會寫回 tokens.json；macOS Docker Desktop 免處理。

# ── 第一方 API 通道（TUI / mobile / dev curl）──────────────────────────────
# Bearer token，設了才會掛載 POST /webhooks/api/messages（同步回覆 agent 原始
# markdown，不經 LINE 驗簽/切塊）。留空＝通道不掛載。用 curl 打進任何房間除錯：
#   curl -s -X POST localhost:8000/webhooks/api/messages \
#     -H "Authorization: Bearer $API_CHANNEL_TOKEN" \
#     -H 'Content-Type: application/json' \
#     -d '{"room_key":"api_dev","text":"你好"}'
# 產生方式：openssl rand -hex 32
API_CHANNEL_TOKEN=change-me

# ── 群組聊天（LINE 群組／多人聊天室）──────────────────────────────────────
# 群組裡 bot 只回覆「點名」它的訊息：@提及官方帳號，或以下面的呼叫詞開頭；其餘訊息
# 只記進該房間的背景 buffer 當脈絡、不回覆（見 docs/group-chat-design.md）。1:1 聊天
# 不受這兩個設定影響，每則都回。容器化部署（docker compose）時，這兩個值經由
# docker-compose.yml 的 environment 清單傳進 router。
#
# 呼叫詞，逗號分隔（各自去掉前後空白）。⚠️ 要服務群組就至少設一個：LINE 桌面版無法
# @ 官方帳號，留空＝只能靠 @mention，桌面版使用者在群組裡會完全叫不動 bot。
# 比對是單純的「前綴比對」：群組文字訊息去掉前後空白後，只要以某個呼叫詞開頭就算點名
# （大小寫敏感、不看字詞邊界——「小幫手們早」「小幫手剛剛答錯了」也會被當成在叫 bot）。
# 請挑群組成員平常聊天、互相稱呼時不會用到的詞，不要用真人的名字。
# 入群自我介紹裡的自稱「小幫手」是寫死在程式裡的（channels/line/adapter.py 的
# _GROUP_JOIN_GREETING），不會跟著這個設定變——建議保留「小幫手」，要加 OA 名稱就用
# 逗號追加，例如 GROUP_TRIGGER_PREFIXES=小幫手,<你的OA名稱>。
# 群組的重置指令也吃呼叫詞前綴：呼叫詞後面直接接指令或只隔空白（「小幫手 /new」、
# 「小幫手/new」）才算；中間夾標點（「小幫手，新對話」）會被當成一般點名訊息處理（通過
# OAuth gate 後送進 agent）。
GROUP_TRIGGER_PREFIXES=小幫手
# 每個群組房間的背景 buffer（data/<room_id>/group_state/observed.jsonl）最多保留幾則
# 未點名訊息，超過丟最舊。預設 50；設 0＝完全不保留背景。
GROUP_OBSERVED_MAX_MESSAGES=50

# ── Session 衛生：每個房間的 Hermes context window 保養 ────────────────────
# Router 自管每個聊天室的「session epoch」，在對話太久沒動或累積太長時，換一個
# 全新的 Hermes session（舊逐字稿保留在舊 id 下、可稽核），避免 context 無限成長
# 導致品質劣化。兩個門檻各自獨立，任一命中就在下一則要進 agent 的訊息輪替；設 0
# 可個別關閉。改完要重啟 router 才生效。
#
# 閒置多久（分鐘）沒有新訊息，就在下一則訊息輪替。預設 1440（1 天），設 0 關閉。
SESSION_IDLE_RESET_MINUTES=1440
# 上一則回應回報的 prompt_tokens 超過這個值就輪替。預設 240000，設 0 關閉。注意：
# 這個數字是「單次請求內所有 tool-loop 迭代的累計」，比實際 context 大小高估，
# 只會提早輪替（安全方向），不要當成 context 視窗大小去調。實測本部署全新 session
# 單一簡單 turn 就回報約 27k（Hermes 系統提示＋skills index 很大，再乘上迭代數），
# 60000 會在逐字稿還很小時就被一般 tool turn 踩中。2026-09-15 起 LLM 後端視窗開到
# 262144，Hermes 壓縮門檻（75% 視窗）跟著變成約 197k，這個值要留在門檻之上讓
# Hermes 自己的壓縮先觸發，所以預設跟著視窗一起倍增到 240000。
SESSION_ROTATE_PROMPT_TOKENS=240000

# ── Log 輸出 ──────────────────────────────────────────────────────────────
# Router 自己的 log 等級與格式（見 docs/logging-design.md）。router 進程裡所有
# logger（含 uvicorn）都走同一個渲染器，每行自帶 request_id／room_key 等欄位。
# LOG_LEVEL：DEBUG / INFO / WARNING / ERROR / CRITICAL，預設 INFO。第三方套件
# （docker、httpx、urllib3）固定壓在 WARNING，所以開 DEBUG 不會被洗版。
LOG_LEVEL=INFO
# LOG_FORMAT：json（預設，一行一個 JSON 物件，`docker compose logs --no-log-prefix
# webhook_router | jq .` 可直接讀——少了 --no-log-prefix 每行前面會多一段服務名，
# jq 會 parse error；這也是之後接集中式 log 收集器要的格式）或 console（彩色、給人
# 看的格式，host 模式在終端機開發時用）。
LOG_FORMAT=json

# ── 對話紀錄（turn envelope）──────────────────────────────────────────────
# 每則進站訊息，router 會寫一筆「turn envelope」到
# data/_conversations/<room_key>.jsonl：結果狀態（replied／observed／reset／
# blocked／agent_failed／silence）、送達與否、耗時、session id、群組脈絡。
# ⚠️ 裡面**不含** agent 的回覆文字；對話內容以每個房間自己的
# data/<room_id>/state.db 為唯一事實來源（見 docs/logging-design.md §5.7）。
# 只有「沒進到 agent」的訊息（observed／blocked／reset…）才會記下原文，因為那些
# state.db 裡根本沒有。用 scripts/conversations.py 把兩邊接起來看。
# 設 false＝不寫這個檔（合約禁止保留任何逐輪紀錄時用）；同一行仍會進 stdout log
# 給收集器。預設 true。
CONVERSATION_LOG_ENABLED=true

# ── 選配：集中式 log 堆疊（Alloy + Loki + Grafana）────────────────────────
# 只有啟用 deploy/logging/docker-compose.logging.yml 時才需要（見 README
# 「選配：集中式 log（Loki）」與 docs/logging-design.md §5.5）。router 程式
# **不會**讀這個變數——它不在 Settings 裡，只給 docker compose 做變數替換，
# 所以留空不會影響 router 啟動；但只要帶了 -f 那份 compose，沒設就會直接
# 讓 compose 失敗（不會靜默起一個 admin/admin 的 Grafana）。
# Grafana 的 admin 密碼（帳號固定 admin）。產生方式：openssl rand -hex 16
# Grafana 只綁 127.0.0.1:3000，operator 用 SSH tunnel 連進去。
GRAFANA_ADMIN_PASSWORD=change-me

# ── 選配：自架 SearXNG 網頁搜尋（給 agent 的 web_search 工具用）───────────
# 沒有搜尋 provider 時，Hermes 內建的 web_search 根本不會出現在 agent 的工具清單
# 裡，agent 只剩瀏覽器工具，會拿沒有防偵測的 headless Chromium 硬闖 Google/Bing
# 搜尋頁、幾乎每次被 bot 驗證擋下——「查一個沒有固定網址的東西」（統編查公司名
# 這類）就是這樣失敗的。deploy/searxng/ 有一份現成的 SearXNG compose，掛在
# hermes_global_net 上；見 README「選配：自架 SearXNG 網頁搜尋」。
#
# Router 轉傳進每個房間容器的 URL（容器 env SEARXNG_URL）。留空（預設）＝停用，
# 行為跟以前完全一樣。啟用填 http://searxng:8080（compose 的容器名，本機與
# 正式部署同一個值）。⚠️ 容器只在建立時讀 env：既有房間要
# `docker rm -f hermes_<room_id>` 讓 router 在下一則訊息時重建（data/ 不受影響）。
SEARXNG_URL=
# SearXNG 自己的 secret_key。**router 不讀這個變數**（不在 Settings 裡），只給
# deploy/searxng/docker-compose.searxng.yml 做變數替換；帶了那份 compose 卻沒設
# 會直接讓 compose 失敗。產生方式：openssl rand -hex 32
SEARXNG_SECRET=change-me

# ── Per-MCP secrets ───────────────────────────────────────────────────────
# Each MCP template under src/hermes/mcp/<name>/ has its own .env.example
# (e.g. src/hermes/mcp/secretary/.env.example — GOOGLE_MAPS_API_KEY, etc.).
# There's nothing to set here in this repo-level .env: once a room's
# container is first created, _ensure_mcp_seed copies that .env.example into
# the room's own data/<room_id>/mcp/<name>/.env, and server.mjs loads it
# itself — edit that per-room file directly to change that room's secrets;
# this repo's Settings never sees its contents.
